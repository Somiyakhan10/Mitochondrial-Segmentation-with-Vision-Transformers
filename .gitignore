# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environment
venv/
.venv/

# Data and models (kept as empty dirs via .gitkeep)
data/raw/*
data/processed/*
data/models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/models/.gitkeep
# Trained checkpoint is committed on purpose so cloud deploys (Render) have it -
# GitHub's hard limit is 100MB and this file is ~93MB.
!data/models/segmentation_unet.pt

